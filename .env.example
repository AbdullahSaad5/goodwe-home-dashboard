# Optional: leave blank to discover the inverter automatically on startup.
GOODWE_HOST=
GOODWE_PORT=502
POLL_INTERVAL_SECONDS=10
STALE_AFTER_SECONDS=30
DASHBOARD_TIMEZONE=Asia/Karachi
DATABASE_PATH=data/goodwe.sqlite3
STATIC_DIR=dist

# Optional command-center configuration. Forecasting remains disabled unless
# both coordinates are present; only those coordinates are sent to Open-Meteo.
BATTERY_CAPACITY_KWH=
BATTERY_RESERVE_PCT=20
INVERTER_RATED_W=
SITE_LATITUDE=
SITE_LONGITUDE=
PV_ARRAY_KWP=
PV_TILT_DEG=
PV_AZIMUTH_DEG=
