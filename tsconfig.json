{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "moduleDetection": "force",
    "baseUrl": ".",
    "paths": { "@/*": ["./web/src/*"] }
  },
  "include": ["web/src", "vite.config.ts", "vitest.config.ts", "eslint.config.js"],
  "exclude": ["node_modules"]
}
